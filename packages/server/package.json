{
  "name": "@ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test --experimental-transform-types \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "perf:million": "tsx scripts/perf-million-tokens.ts",
    "test:context": "node --test --experimental-transform-types \"src/context/**/*.test.ts\"",
    "db:rollback": "tsx src/db/migrate.ts --rollback",
    "test:security": "node --test --experimental-transform-types \"test/security.test.ts\"",
    "test:research": "node --test --experimental-transform-types \"src/research/**/*.test.ts\"",
    "test:office": "node --test --experimental-transform-types \"src/office/**/*.test.ts\"",
    "test:goals": "node --test --experimental-transform-types \"src/goals/**/*.test.ts\"",
    "verify:rollback": "tsx scripts/verify-rollback.ts"
  },
  "dependencies": {
    "@ai/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.0.3",
    "drizzle-orm": "^0.36.4",
    "exceljs": "^4.4.0",
    "hono": "^4.6.10",
    "nanoid": "^5.0.9",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
