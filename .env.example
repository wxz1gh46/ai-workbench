# ============ 服务端 ============
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# 本地 SQLite 数据目录（默认 <repo>/data）
DATA_DIR=./data
# 本地文件存储目录
STORAGE_DIR=./data/storage

# ============ 模型接入（用户自行配置，不硬编码）============
# 默认使用的模型供应商: openai | anthropic | google | openai-compatible
AI_DEFAULT_PROVIDER=openai-compatible
# 兼容 OpenAI API 的地址（本地模型 / 中转网关均可）
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
# 普通模型
AI_MODEL=gpt-4o-mini
# 长上下文模型（百万 Token 场景自动路由）
AI_LONG_CONTEXT_MODEL=gpt-4.1
# 长上下文阈值（tokens），超过则切换到长上下文模型
AI_LONG_CONTEXT_THRESHOLD=120000

# ---- Phase 2：分层上下文 ----
# 单次请求上下文总预算（六个分区共享，含输出预留 5%）
AI_CONTEXT_BUDGET=200000
# 滚动摘要触发阈值（token）。留空/0 表示按上下文预算自动推算（= 近期原文分区上限）
AI_COMPACT_THRESHOLD=0
# 远端 embedding 模型；留空则使用本地确定性 embedding（离线可用，无需密钥）
AI_EMBEDDING_MODEL=
# 递归摘要用的廉价模型；留空则复用 AI_MODEL
AI_SUMMARY_MODEL=

# ---- Phase 2：深度研究（必须由用户自行提供，绝不内置第三方密钥）----
# 检索端点：兼容返回 {results|items|data|hits:[{url,title,content}]} 的 JSON
# 推荐自建 SearXNG：https://github.com/searxng/searxng
# 形如 http://127.0.0.1:8888/search?format=json  （留空则禁用联网检索）
RESEARCH_SEARCH_ENDPOINT=
# 检索端点需要鉴权时填写（可选）
RESEARCH_SEARCH_API_KEY=
# 抓取并发与超时
RESEARCH_FETCH_CONCURRENCY=4
RESEARCH_FETCH_TIMEOUT_MS=15000
RESEARCH_MAX_BYTES_PER_PAGE=400000
# 抓取 UA：请填写可联系的标识，遵守目标站点 robots.txt（不可关闭）
RESEARCH_USER_AGENT=AIWorkbenchBot/0.2 (+local research; contact: you@example.com)

# ---- Phase 2：Office 转换（可选外部依赖）----
# LibreOffice headless 可执行文件路径（如 /usr/bin/soffice）。
# 留空则禁用跨格式转换，但不影响同格式读取/编辑与直接生成 docx/xlsx/pptx/pdf。
SOFFICE_PATH=
OFFICE_CONVERT_TIMEOUT_MS=60000

# ============ 云端数据库（Phase 3，用户手动配置）============
# Neon / Supabase 连接串，仅用户本地填写
DATABASE_URL=

# ============ 部署平台 Token（Phase 3，用户手动配置）============
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
NETLIFY_AUTH_TOKEN=

# ============ 推送渠道（Phase 3，用户手动配置）============
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
SMTP_URL=

# ============ Phase 3：加密存储（强烈建议配置）============
# 本地密钥派生用。长度 ≥32 位；未配置时会生成本机 data/secrets/local.key 并告警。
# 跨机迁移 / 多实例部署必须显式配置，否则旧密文无法解密。
WORKBENCH_SECRET_KEY=

# ============ Phase 3：部署平台（按需配置，用哪个配哪个）============
# 所有 Token 都由你手动申请，工作台不代持、不写入代码/日志/DB
# Vercel：https://vercel.com/account/tokens
VERCEL_TOKEN=
# Cloudflare Pages：https://dash.cloudflare.com/profile/api-tokens
# 需要权限：Cloudflare Pages:Edit
CLOUDFLARE_API_TOKEN=
# 控制台右侧的 Account ID
CLOUDFLARE_ACCOUNT_ID=
# 可选：指定 Pages 项目名（回滚与删除部署需要）
CLOUDFLARE_PROJECT=
# Netlify：https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=
# 可选：复用已有站点（回滚与绑定域名需要）
NETLIFY_SITE_ID=

# ============ Phase 3：数据库（可选的管理类凭据）============
# 注意：真正的连接串不写在这里！请到「数据库面板」输入，会加密后入库。
# Neon 管理 API（仅用于列项目/分支）：https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
# Supabase 管理 API（仅用于列项目）：https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ============ Phase 3：通知渠道（按需配置；也可在 UI 创建后加密存储）============
# 飞书 / 钉钉 / 企业微信 的机器人 Webhook 需要在各自群里创建
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_SIGN_SECRET=
WECOM_WEBHOOK_URL=
# SMTP（授权码不是邮箱密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ============ Phase 3：调试与安全 ============
# 仅本地调试自建 Postgres 时使用（云端 Neon/Supabase 必须保持 SSL）
# PGSSLMODE=disable
# 单条 SQL 超时（毫秒）
PG_STATEMENT_TIMEOUT=30000
